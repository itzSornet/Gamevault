{
  "name": "gamevault",
  "version": "2.0.1",
  "description": "Modern personal game library manager, playtime tracker, and launcher.",
  "main": "main.js",
  "author": "itzSornet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itzSornet/Gamevault.git"
  },
  "keywords": [
    "electron",
    "game-launcher",
    "game-library",
    "playtime-tracker",
    "steam",
    "epic-games",
    "steamgriddb"
  ],
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable",
    "test": "node --test \"tests/**/*.test.js\"",
    "release:win": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.gamevault.app",
    "productName": "GameVault",
    "publish": [
      {
        "provider": "github",
        "owner": "itzSornet",
        "repo": "Gamevault"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "LICENSE",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/icon.ico",
      "uninstallerIcon": "src/icon.ico",
      "installerSidebar": "installer/sidebar.bmp",
      "uninstallerSidebar": "installer/sidebar.bmp",
      "installerHeader": "installer/header.bmp",
      "shortcutName": "GameVault",
      "runAfterFinish": true,
      "include": "installer/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
