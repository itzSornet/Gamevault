# Maintainer: itzSornet <itzsornet@users.noreply.github.com>
pkgname=gamevault
pkgver=1.3.0
pkgrel=1
pkgdesc="Modern personal game library manager, playtime tracker, and launcher"
arch=('x86_64')
url="https://github.com/itzSornet/Gamevault"
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'glib2'
  'gtk3'
  'libcups'
  'libdrm'
  'libnotify'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'xdg-utils'
)
optdepends=('steam: Steam library detection and launching')
provides=('gamevault')
conflicts=('gamevault-bin')
options=('!strip' '!debug' '!emptydirs')

source=("${pkgname}-${pkgver}.AppImage::${url}/releases/download/v${pkgver}/GameVault-${pkgver}.AppImage"
        "gamevault.desktop")
sha256sums=('aaee7e85c95a5f7486e69ee00177b052e77ab8e0a9a4b1c65e53e8a26bd20960'
            '39975cd807a11a86578a54d48c35e396591390686ec3f1ea4ddc8d806092bf9c')

prepare() {
  chmod +x "${srcdir}/${pkgname}-${pkgver}.AppImage"
  ( cd "${srcdir}" && ./"${pkgname}-${pkgver}.AppImage" --appimage-extract >/dev/null )
}

package() {
  # Prebuilt Electron bundle in /opt/gamevault
  install -d "${pkgdir}/opt/gamevault"
  cp -a "${srcdir}/squashfs-root/." "${pkgdir}/opt/gamevault/"

  # AppImage runtime wrapper is not used when installed system-wide
  rm -f "${pkgdir}/opt/gamevault/AppRun" "${pkgdir}/opt/gamevault/gamevault.desktop"

  # Executable on PATH
  install -d "${pkgdir}/usr/bin"
  ln -sf /opt/gamevault/gamevault "${pkgdir}/usr/bin/gamevault"

  # Desktop entry
  install -Dm644 "${srcdir}/gamevault.desktop" \
    "${pkgdir}/usr/share/applications/gamevault.desktop"

  # The bundle files its icon under the non-standard hicolor/0x0 path
  install -Dm644 "${pkgdir}/opt/gamevault/usr/share/icons/hicolor/0x0/apps/gamevault.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/gamevault.png"
}
