# Maintainer: itzSornet
pkgname=gamevault-bin
pkgver=1.3.0
pkgrel=1
pkgdesc="Modern personal game library manager, playtime tracker, and launcher (binary release)"
arch=('x86_64')
url="https://github.com/itzSornet/Gamevault"
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'cups'
  'dbus'
  'expat'
  'glib2'
  'gtk3'
  'libdrm'
  'libnotify'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'xdg-utils'
)
optdepends=(
  'steam: Steam library detection and launching'
)
provides=('gamevault')
conflicts=('gamevault')
source=("${pkgname}-${pkgver}.AppImage::https://github.com/itzSornet/Gamevault/releases/download/v${pkgver}/GameVault-${pkgver}.AppImage"
        "gamevault.desktop")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  chmod +x "${pkgname}-${pkgver}.AppImage"
  ./"${pkgname}-${pkgver}.AppImage" --appimage-extract >/dev/null
}

package() {
  # Application bundle in /opt/gamevault
  install -d "${pkgdir}/opt/gamevault"
  cp -r squashfs-root/* "${pkgdir}/opt/gamevault/"

  # Remove AppImage runtime wrapper relic
  rm -f "${pkgdir}/opt/gamevault/AppRun"

  # Executable symlink in /usr/bin
  install -d "${pkgdir}/usr/bin"
  ln -sf "/opt/gamevault/gamevault" "${pkgdir}/usr/bin/gamevault"

  # Desktop entry
  install -Dm644 "${srcdir}/gamevault.desktop" "${pkgdir}/usr/share/applications/gamevault.desktop"

  # Icon in hicolor
  if [ -f "${srcdir}/squashfs-root/gamevault.png" ]; then
    install -Dm644 "${srcdir}/squashfs-root/gamevault.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/gamevault.png"
  fi
}
